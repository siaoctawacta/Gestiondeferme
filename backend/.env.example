DATABASE_URL="postgresql://agripilot:agripilot@localhost:5432/agripilot"
# At least 32 random characters (openssl rand -base64 48). scripts/dev.sh fills this in.
JWT_SECRET=
# 32 bytes, base64 or hex encoded (e.g. `openssl rand -base64 32`)
TOTP_ENC_KEY=
WEB_ORIGIN="http://localhost:5173"
# Public address of the web app, encoded in the QR labels (`{APP_URL}/q/{kind}/{id}`). Defaults to WEB_ORIGIN.
APP_URL=
PORT=3000
# Set when behind a reverse proxy (nginx) so rate limiting sees the real client IP.
# Number of hops (e.g. 1), `true`, or an Express trust-proxy value. Leave unset otherwise.
TRUST_PROXY=

# Used only by `npx prisma db seed`
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Swagger UI (/api/docs) is served outside production. In production it stays off
# unless this is exactly `true`.
ENABLE_API_DOCS=

# Where uploaded files (task proof photos) are stored; default `uploads` under the
# backend's working directory (/app/uploads in Docker, the api-uploads volume).
UPLOAD_DIR=

# Demo « Ferme Kpalimé » (`npm run seed:demo`, after `npx prisma db seed`): one account per role, <role>@kpalime.demo,
# all with this password (at least 10 characters; 16 when forced in production). It is read from the environment or from
# this file; `scripts/dev.sh --demo` generates its own when none is set.
# WARNING: the demo creates 12 accounts sharing ONE password, among them a SUPER ADMINISTRATOR
# (super.admin@kpalime.demo) with no second factor enrolled. Delete them before any real use and never load the demo
# on an installation that can be reached.
DEMO_PASSWORD=
# The demo is refused when NODE_ENV=production, unless this is exactly 1 (evaluation installs; the Docker image runs
# in production mode).
ALLOW_DEMO_SEED=
# `npm run demo:reset` DESTROYS THE ENTIRE DATABASE (prisma migrate reset), then reloads the seed and the demo. It runs
# only with ALLOW_DEMO_RESET=1, outside production, on a database at localhost, 127.0.0.1 or the compose `db` host, and
# needs SEED_ADMIN_EMAIL and SEED_ADMIN_PASSWORD in the environment. Leave this empty everywhere else.
ALLOW_DEMO_RESET=
