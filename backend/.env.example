DATABASE_URL="postgresql://agripilot:agripilot@localhost:5432/agripilot"
JWT_SECRET="change-me-to-a-long-random-string"
# 32 bytes, base64 or hex encoded (e.g. `openssl rand -base64 32`)
TOTP_ENC_KEY="change-me-32-bytes-base64"
WEB_ORIGIN="http://localhost:5173"
PORT=3000
# Set when behind a reverse proxy (nginx) so rate limiting sees the real client IP.
# Number of hops (e.g. 1), `true`, or an Express trust-proxy value. Leave unset otherwise.
TRUST_PROXY=

# Used only by `npx prisma db seed`
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
