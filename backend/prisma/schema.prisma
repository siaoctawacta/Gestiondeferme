/// What an expense or a revenue is about; a purchase line snapshots its category at reception.
enum FinanceCategory {
  ANIMAUX
  ALIMENT
  SANTE
  MATERIEL
  CONSOMMABLES
  SALAIRES
  ENERGIE
  EAU
  TRANSPORT
  ENTRETIEN
  AUTRE_CHARGE
  VENTE_ANIMAUX
  VENTE_OEUFS
  VENTE_ARTICLES
  PRESTATIONS
  AUTRE_RECETTE
}

/// The branch of the farm a document belongs to (GENERAL = shared charges).
enum Activity {
  AVICOLE
  PORCIN
  GENERAL
}

/// A purchase request (DA-NNNN) that becomes an order (BC-NNNN), is received into the stock ledger, then paid.
/// READ BY "FinanceLedgerView" (see the header): changing a column it reads means dropping the view, migrating, recreating it.
model Purchase {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  farmId         String
  farm           Farm              @relation(fields: [farmId], references: [id], onDelete: Restrict)
  supplierId     String
  supplier       Supplier          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  /// DA-NNNN, assigned at creation.
  reference      String
  /// BC-NNNN, assigned at order.
  orderNumber    String?
  date           DateTime          @db.Date
  status         PurchaseStatus    @default(DEMANDE)
  requestedById  String
  requestedBy    User              @relation("PurchaseRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  validatedById  String?
  validatedBy    User?             @relation("PurchaseValidatedBy", fields: [validatedById], references: [id], onDelete: Restrict)
  validatedAt    DateTime?
  orderedById    String?
  orderedBy      User?             @relation("PurchaseOrderedBy", fields: [orderedById], references: [id], onDelete: Restrict)
  orderedAt      DateTime?
  receivedById   String?
  receivedBy     User?             @relation("PurchaseReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)
  receivedAt     DateTime?
  receivedDate   DateTime?         @db.Date
  cancelledById  String?
  cancelledBy    User?             @relation("PurchaseCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  cancelledAt    DateTime?
  cancelReason   String?
  note           String?
  activity       Activity          @default(GENERAL)
  /// Σ of the line amounts (received quantities once received); written only by PurchasesService from common/money.ts.
  amount         Decimal           @default(0) @db.Decimal(14, 2)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  items          PurchaseItem[]
  payments       SupplierPayment[]

  @@unique([organizationId, reference])
  @@unique([organizationId, orderNumber])
  @@index([farmId])
  @@index([supplierId])
  @@index([requestedById])
  @@index([validatedById])
  @@index([orderedById])
  @@index([receivedById])
  @@index([cancelledById])
  @@index([farmId, status])
  @@index([farmId, date])
}

/// READ BY "FinanceLedgerView" (see the header): changing a column it reads means dropping the view, migrating, recreating it.
model PurchaseItem {
  id               String           @id @default(cuid())
  purchaseId       String
  purchase         Purchase         @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  stockItemId      String
  stockItem        StockItem        @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  /// Order of the line on the document.
  position         Int
  quantity         Decimal          @db.Decimal(12, 2)
  unitPrice        Decimal          @db.Decimal(12, 2)
  receivedQuantity Decimal?         @db.Decimal(12, 2)
  /// round(COALESCE(receivedQuantity, quantity) × unitPrice, 2), CHECKed in SQL.
  amount           Decimal          @db.Decimal(14, 2)
  /// Snapshot at reception of the article's category (it is mutable); null until received, and for a line received at 0.
  expenseCategory  FinanceCategory?
  lotNumber        String?
  expiryDate       DateTime?        @db.Date

  @@unique([purchaseId, position])
  @@index([stockItemId])
}

model SupplierPayment {
  id          String        @id @default(cuid())
  farmId      String
  farm        Farm          @relation(fields: [farmId], references: [id], onDelete: Restrict)
  purchaseId  String
  purchase    Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  date        DateTime      @db.Date
  amount      Decimal       @db.Decimal(14, 2)
  method      PaymentMethod
  reference   String?
  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime      @default(now())

  @@index([farmId])
  @@index([purchaseId])
  @@index([createdById])
}

enum HealthActType {
  VACCINATION
  TRAITEMENT
  DESINFECTION
  DIAGNOSTIC
}

/// `EN_RETARD` is derived (planned and dated before today), never stored.
enum HealthActStatus {
  PLANIFIE
  REALISE
  ANNULE
}

enum QuarantineStatus {
  EN_COURS
  LEVEE
}

enum IncidentSeverity {
  FAIBLE
  MOYENNE
  GRAVE
}

enum IncidentStatus {
  OUVERT
  CLOS
}

enum BiosecurityType {
  NETTOYAGE
  DESINFECTION
  PEDILUVE
  VISITEUR
}

/// A vaccination, treatment, disinfection or diagnosis on exactly one lot, animal or building (a disinfection: a building only).
/// A done act with a stock article and a quantity consumes the stock through the ledger (source HEALTH_ACT, this row's id).
model HealthAct {
  id             String           @id @default(cuid())
  farmId         String
  farm           Farm             @relation(fields: [farmId], references: [id], onDelete: Restrict)
  /// The planned date, or the day it was done for an act created as done.
  date           DateTime         @db.Date
  type           HealthActType
  batchId        String?
  batch          AnimalBatch?     @relation(fields: [batchId], references: [id], onDelete: Restrict)
  animalId       String?
  animal         Animal?          @relation(fields: [animalId], references: [id], onDelete: Restrict)
  buildingId     String?
  building       Building?        @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  stockItemId    String?
  stockItem      StockItem?       @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  /// The product lot the exit was asked from; null = nearest expiry first.
  stockBatchId   String?
  stockBatch     StockBatch?      @relation(fields: [stockBatchId], references: [id], onDelete: Restrict)
  productName    String?
  dose           String?
  quantity       Decimal?         @db.Decimal(12, 2)
  durationDays   Int?
  withdrawalDays Int?
  veterinarian   String?
  symptoms       String?
  diagnosis      String?
  status         HealthActStatus  @default(PLANIFIE)
  /// Set exactly while the act is REALISE.
  doneDate       DateTime?        @db.Date
  /// Entered as done (its date is the day it was done) rather than completed from a planned act.
  enteredDone    Boolean          @default(false)
  planId         String?
  plan           VaccinationPlan? @relation(fields: [planId], references: [id], onDelete: Restrict)
  note           String?
  createdById    String
  createdBy      User             @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([farmId])
  @@index([farmId, date])
  @@index([farmId, status])
  @@index([batchId])
  @@index([animalId])
  @@index([buildingId])
  @@index([stockItemId])
  @@index([stockBatchId])
  @@index([planId])
  @@index([createdById])
}

/// Organisation master data: a vaccination programme applied to lots of one species.
model VaccinationPlan {
  id             String                @id @default(cuid())
  organizationId String
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String
  species        Species
  /// Lot type the plan is meant for; null = any type of the species.
  type           BatchType?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  items          VaccinationPlanItem[]
  acts           HealthAct[]

  @@unique([organizationId, name])
}

model VaccinationPlanItem {
  id          String          @id @default(cuid())
  planId      String
  plan        VaccinationPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  /// Days after the lot's entry date.
  ageDays     Int
  productName String
  stockItemId String?
  stockItem   StockItem?      @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  dose        String?

  @@index([planId])
  @@index([stockItemId])
}

model Quarantine {
  id        String           @id @default(cuid())
  farmId    String
  farm      Farm             @relation(fields: [farmId], references: [id], onDelete: Restrict)
  batchId   String?
  batch     AnimalBatch?     @relation(fields: [batchId], references: [id], onDelete: Restrict)
  animalId  String?
  animal    Animal?          @relation(fields: [animalId], references: [id], onDelete: Restrict)
  startDate DateTime         @db.Date
  /// Planned end while EN_COURS; the day it was lifted once LEVEE.
  endDate   DateTime?        @db.Date
  reason    String
  status    QuarantineStatus @default(EN_COURS)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([farmId])
  @@index([farmId, startDate])
  @@index([batchId])
  @@index([animalId])
}

model HealthIncident {
  id          String           @id @default(cuid())
  farmId      String
  farm        Farm             @relation(fields: [farmId], references: [id], onDelete: Restrict)
  date        DateTime         @db.Date
  title       String
  description String?
  severity    IncidentSeverity
  batchId     String?
  batch       AnimalBatch?     @relation(fields: [batchId], references: [id], onDelete: Restrict)
  buildingId  String?
  building    Building?        @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  status      IncidentStatus   @default(OUVERT)
  /// Set exactly while the incident is CLOS.
  closedAt    DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([farmId])
  @@index([farmId, date])
  @@index([batchId])
  @@index([buildingId])
}

model BiosecurityLog {
  id          String          @id @default(cuid())
  farmId      String
  farm        Farm            @relation(fields: [farmId], references: [id], onDelete: Restrict)
  date        DateTime        @db.Date
  type        BiosecurityType
  buildingId  String?
  building    Building?       @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  productName String?
  visitorName String?
  note        String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([farmId])
  @@index([farmId, date])
  @@index([buildingId])
}

/// Highest number ever handed out per organisation and kind: only goes up, so a deleted number is never reused.
model DocumentCounter {
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// DA|BC|DV|FA|AV|RC (purchase request, order, quote, invoice, credit note, receipt).
  kind           String
  last           Int

  @@id([organizationId, kind])
}

enum CustomerType {
  PARTICULIER
  REVENDEUR
  RESTAURANT
  GROSSISTE
}

/// What a sale line sells: a lot's birds or piglets, one tracked animal, eggs of a lot, a stock article, or a service.
enum SaleLineKind {
  LOT
  ANIMAL
  OEUFS
  ARTICLE
  SERVICE
}

/// `EXPIRE` is derived (sent and past its validity), never stored.
enum QuoteStatus {
  BROUILLON
  ENVOYE
  ACCEPTE
  REFUSE
  FACTURE
}

enum InvoiceStatus {
  BROUILLON
  EMISE
  PARTIELLE
  SOLDEE
  ANNULEE
}

enum CustomerPaymentKind {
  ENCAISSEMENT
  REMBOURSEMENT
}

/// Organisation master data (not farm-scoped).
/// READ BY "FinanceLedgerView" (see the header): changing a column it reads means dropping the view, migrating, recreating it.
model Customer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String
  type           CustomerType
  phone          String?
  email          String?
  city           String?
  address        String?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  quotes         Quote[]
  invoices       Invoice[]

  @@unique([organizationId, name])
}

/// A quote (DV-NNNN): lines naming their source, no ledger effect. Converted into an invoice draft (the invoice's `quoteId` is the only link).
model Quote {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  farmId         String
  farm           Farm         @relation(fields: [farmId], references: [id], onDelete: Restrict)
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  /// DV-NNNN, assigned at creation.
  reference      String
  date           DateTime     @db.Date
  validUntil     DateTime?    @db.Date
  status         QuoteStatus  @default(BROUILLON)
  /// Σ of the line amounts; written only by QuotesService from sales/sale-money.ts.
  total          Decimal      @default(0) @db.Decimal(14, 2)
  note           String?
  createdById    String
  createdBy      User         @relation("QuoteCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  sentAt         DateTime?
  sentById       String?
  sentBy         User?        @relation("QuoteSentBy", fields: [sentById], references: [id], onDelete: Restrict)
  acceptedAt     DateTime?
  refusedAt      DateTime?
  decidedById    String?
  decidedBy      User?        @relation("QuoteDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)
  /// The invoice made from this quote (the invoice's `quoteId` is the only link).
  invoice        Invoice?     @relation("InvoiceQuote")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  lines          QuoteLine[]

  @@unique([organizationId, reference])
  @@index([farmId])
  @@index([customerId])
  @@index([createdById])
  @@index([sentById])
  @@index([decidedById])
  @@index([farmId, status])
  @@index([farmId, date])
}

/// The line shape shared with the invoice lines; the CHECKs in the migration tie `kind` to the source columns.
model QuoteLine {
  id          String       @id @default(cuid())
  quoteId     String
  quote       Quote        @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  position    Int
  kind        SaleLineKind
  batchId     String?
  batch       AnimalBatch? @relation(fields: [batchId], references: [id], onDelete: Restrict)
  animalId    String?
  animal      Animal?      @relation(fields: [animalId], references: [id], onDelete: Restrict)
  stockItemId String?
  stockItem   StockItem?   @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  /// Eggs in one unit (tray or egg), snapshotted from the `eggsPerTray` setting; OEUFS lines only.
  eggsPerUnit Int?
  designation String
  unit        String?
  quantity    Decimal      @db.Decimal(12, 2)
  unitPrice   Decimal      @db.Decimal(12, 2)
  /// round(quantity × unitPrice, 2), CHECKed in SQL.
  amount      Decimal      @db.Decimal(14, 2)
  weightKg    Decimal?     @db.Decimal(12, 2)

  @@unique([quoteId, position])
  @@index([batchId])
  @@index([animalId])
  @@index([stockItemId])
}

/// A sales invoice. A draft has no number and touches nothing; the FA-NNNN number is assigned at issue (so issued numbers have no gaps) and kept when the invoice is cancelled.
/// READ BY "FinanceLedgerView" (see the header): changing a column it reads means dropping the view, migrating, recreating it.
model Invoice {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  farmId         String
  farm           Farm              @relation(fields: [farmId], references: [id], onDelete: Restrict)
  customerId     String
  customer       Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  /// FA-NNNN, null while a draft (CHECKed both ways with the status).
  number         String?
  date           DateTime          @db.Date
  dueDate        DateTime?         @db.Date
  status         InvoiceStatus     @default(BROUILLON)
  /// The quote this invoice was made from.
  quoteId        String?           @unique
  quote          Quote?            @relation("InvoiceQuote", fields: [quoteId], references: [id], onDelete: Restrict)
  /// Σ of the line amounts; written only by InvoicesService from sales/sale-money.ts.
  total          Decimal           @default(0) @db.Decimal(14, 2)
  note           String?
  createdById    String
  createdBy      User              @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  issuedAt       DateTime?
  issuedById     String?
  issuedBy       User?             @relation("InvoiceIssuedBy", fields: [issuedById], references: [id], onDelete: Restrict)
  cancelledAt    DateTime?
  cancelledById  String?
  cancelledBy    User?             @relation("InvoiceCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  cancelReason   String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  lines          InvoiceLine[]
  payments       CustomerPayment[]
  creditNotes    CreditNote[]

  @@unique([organizationId, number])
  @@index([farmId])
  @@index([customerId])
  @@index([createdById])
  @@index([issuedById])
  @@index([cancelledById])
  @@index([farmId, status])
  @@index([farmId, date])
}

/// The line shape of QuoteLine, plus what the line is counted as in finance (set from sales/sale-lines.ts on every save).
/// READ BY "FinanceLedgerView" (see the header): changing a column it reads means dropping the view, migrating, recreating it.
model InvoiceLine {
  id              String           @id @default(cuid())
  invoiceId       String
  invoice         Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  position        Int
  kind            SaleLineKind
  batchId         String?
  batch           AnimalBatch?     @relation(fields: [batchId], references: [id], onDelete: Restrict)
  animalId        String?
  animal          Animal?          @relation(fields: [animalId], references: [id], onDelete: Restrict)
  stockItemId     String?
  stockItem       StockItem?       @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  /// Eggs in one unit (tray or egg), snapshotted from the `eggsPerTray` setting; OEUFS lines only.
  eggsPerUnit     Int?
  designation     String
  unit            String?
  quantity        Decimal          @db.Decimal(12, 2)
  unitPrice       Decimal          @db.Decimal(12, 2)
  /// round(quantity × unitPrice, 2), CHECKed in SQL.
  amount          Decimal          @db.Decimal(14, 2)
  weightKg        Decimal?         @db.Decimal(12, 2)
  activity        Activity
  revenueCategory FinanceCategory
  creditLines     CreditNoteLine[]

  @@unique([invoiceId, position])
  @@index([batchId])
  @@index([animalId])
  @@index([stockItemId])
}

/// A client payment: an encashment, or a refund of what a credit note left owed back. Its `RC-NNNN` is the receipt.
/// Enforced by the service under the invoice row lock, NOT by SQL: amount <= what is due (or owed back), farm = the invoice's farm. Issuing an invoice with a payment writes two audit rows (the invoice and the payment).
model CustomerPayment {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  farmId         String
  farm           Farm                @relation(fields: [farmId], references: [id], onDelete: Restrict)
  invoiceId      String
  invoice        Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  /// RC-NNNN, per organisation.
  number         String
  kind           CustomerPaymentKind @default(ENCAISSEMENT)
  date           DateTime            @db.Date
  /// > 0, CHECKed in SQL.
  amount         Decimal             @db.Decimal(14, 2)
  method         PaymentMethod
  reference      String?
  createdById    String
  createdBy      User                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime            @default(now())

  @@unique([organizationId, number])
  @@index([farmId])
  @@index([invoiceId])
  @@index([createdById])
}

/// A credit note (avoir): final, never edited or deleted. Its lines say how much of each invoice line it takes back.
/// Enforced by the service under the invoice row lock, NOT by SQL: Σ credit lines of an invoice line <= that line's quantity and amount, Σ credit notes <= the invoice total, the credit note's farm = its invoice's farm.
/// A credit note worth nothing (every line already used up by rounding) is refused (400).
/// READ BY "FinanceLedgerView" (see the header): changing a column it reads means dropping the view, migrating, recreating it.
model CreditNote {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  farmId         String
  farm           Farm             @relation(fields: [farmId], references: [id], onDelete: Restrict)
  invoiceId      String
  invoice        Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  /// AV-NNNN, per organisation.
  number         String
  date           DateTime         @db.Date
  reason         String
  /// The goods came back: lots, eggs and articles re-enter their ledgers at `date`.
  withReturn     Boolean
  /// Σ of the line amounts, > 0.
  total          Decimal          @db.Decimal(14, 2)
  createdById    String
  createdBy      User             @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime         @default(now())
  lines          CreditNoteLine[]

  @@unique([organizationId, number])
  @@index([farmId])
  @@index([invoiceId])
  @@index([createdById])
  @@index([farmId, date])
}

/// READ BY "FinanceLedgerView" (see the header): changing a column it reads means dropping the view, migrating, recreating it.
model CreditNoteLine {
  id            String      @id @default(cuid())
  creditNoteId  String
  creditNote    CreditNote  @relation(fields: [creditNoteId], references: [id], onDelete: Restrict)
  invoiceLineId String
  invoiceLine   InvoiceLine @relation(fields: [invoiceLineId], references: [id], onDelete: Restrict)
  quantity      Decimal     @db.Decimal(12, 2)
  /// From `creditLineAmount` only; 0 is allowed when the line's amount is already used up.
  amount        Decimal     @db.Decimal(14, 2)

  @@unique([creditNoteId, invoiceLineId])
  @@index([invoiceLineId])
}

enum FinanceKind {
  DEPENSE
  RECETTE
}

/// A manual finance entry (salaries, energy, ...). Everything else the finance screens list is derived at read time from its documents by the SQL view "FinanceLedgerView" (not modelled here: nothing writes it).
/// READ BY "FinanceLedgerView" (see the header): changing a column it reads means dropping the view, migrating, recreating it.
model FinanceEntry {
  id          String          @id @default(cuid())
  farmId      String
  farm        Farm            @relation(fields: [farmId], references: [id], onDelete: Restrict)
  date        DateTime        @db.Date
  kind        FinanceKind
  label       String
  activity    Activity
  category    FinanceCategory
  /// > 0, CHECKed in SQL (a credit note is negative only in the view).
  amount      Decimal         @db.Decimal(14, 2)
  /// The lot an expense is attributed to (DEPENSE on AVICOLE / PORCIN only, CHECKed in SQL).
  batchId     String?
  batch       AnimalBatch?    @relation(fields: [batchId], references: [id], onDelete: Restrict)
  note        String?
  createdById String
  createdBy   User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([farmId, date])
  @@index([batchId])
  @@index([createdById])
}

enum ContractType {
  CDI
  CDD
  JOURNALIER
  STAGE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  CONGE
  MALADIE
}

/// A member of a farm's staff (master data). He needs no account: `userId` links him to ONE user of the farm when he has one.
/// CHECKed in SQL: monthlySalary >= 0; endDate is null or on/after hireDate.
model Employee {
  id            String       @id @default(cuid())
  farmId        String
  farm          Farm         @relation(fields: [farmId], references: [id], onDelete: Restrict)
  /// As shown on screens, e.g. « Kodjo A. ».
  name          String
  fullName      String?
  jobTitle      String
  phone         String?
  contractType  ContractType
  hireDate      DateTime     @db.Date
  endDate       DateTime?    @db.Date
  /// Visible only with finance:read.
  monthlySalary Decimal?     @db.Decimal(12, 2)
  userId        String?
  user          User?        @relation(fields: [userId], references: [id], onDelete: Restrict)
  note          String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  attendances   Attendance[]
  tasks         Task[]

  @@unique([farmId, name])
  @@unique([farmId, userId])
  @@index([farmId])
  @@index([userId])
}

/// One day of one employee (daily entry). CHECKed in SQL: hours is null or in (0, 24] and only for PRESENT.
model Attendance {
  id          String           @id @default(cuid())
  farmId      String
  farm        Farm             @relation(fields: [farmId], references: [id], onDelete: Restrict)
  employeeId  String
  employee    Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  date        DateTime         @db.Date
  status      AttendanceStatus
  hours       Decimal?         @db.Decimal(4, 2)
  note        String?
  createdById String
  createdBy   User             @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([employeeId, date])
  @@index([farmId, date])
  @@index([createdById])
}

enum TaskStatus {
  A_FAIRE
  EN_COURS
  TERMINEE
}

/// Declared in increasing urgency: ordering by it descending puts URGENTE first.
enum TaskPriority {
  NORMALE
  HAUTE
  URGENTE
}

enum TaskRecurrence {
  AUCUNE
  QUOTIDIENNE
  HEBDOMADAIRE
  MENSUELLE
}

/// A farm task (daily entry). CHECKed in SQL: dueTime is HH:mm, at most one of batchId / buildingId / equipmentId,
/// completedDate is set exactly while TERMINEE, proofPath and proofMime are both set or both null.
model Task {
  id             String         @id @default(cuid())
  farmId         String
  farm           Farm           @relation(fields: [farmId], references: [id], onDelete: Restrict)
  title          String
  description    String?
  assigneeId     String?
  assignee       Employee?      @relation(fields: [assigneeId], references: [id], onDelete: Restrict)
  dueDate        DateTime       @db.Date
  /// HH:mm
  dueTime        String?
  priority       TaskPriority   @default(NORMALE)
  status         TaskStatus     @default(A_FAIRE)
  recurrence     TaskRecurrence @default(AUCUNE)
  /// Day of the month a MENSUELLE series is anchored on (1-31), so 31 Jan, 28 Feb, 31 Mar do not drift to the 28th. Null until the first completion.
  recurrenceDay  Int?
  batchId        String?
  batch          AnimalBatch?   @relation(fields: [batchId], references: [id], onDelete: Restrict)
  buildingId     String?
  building       Building?      @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  /// The foreign key to Equipment is added with that table (equipment module).
  equipmentId    String?
  startedAt      DateTime?
  /// Set exactly while TERMINEE.
  completedDate  DateTime?      @db.Date
  completedById  String?
  completedBy    User?          @relation("TaskCompletedBy", fields: [completedById], references: [id], onDelete: Restrict)
  /// Relative to UPLOAD_DIR; never a client-supplied name.
  proofPath      String?
  proofMime      String?
  /// The occurrence this one was generated from when that one was completed.
  previousTaskId String?        @unique
  previousTask   Task?          @relation("TaskRecurrence", fields: [previousTaskId], references: [id], onDelete: Restrict)
  nextTask       Task?          @relation("TaskRecurrence")
  createdById    String
  createdBy      User           @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([farmId])
  @@index([farmId, status])
  @@index([farmId, dueDate])
  @@index([assigneeId])
  @@index([batchId])
  @@index([buildingId])
  @@index([equipmentId])
  @@index([completedById])
  @@index([createdById])
}
