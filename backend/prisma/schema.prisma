generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  // relationJoins: the feed and water services pass `relationLoadStrategy: 'join'`
  // to load a row with its batch/building/product names in one query. With the
  // flag on, Prisma's default relation load strategy may itself be `join`, so
  // queries that rely on `query` (separate round trips) must say so explicitly.
  // The client relies on it, hence `prisma` / `@prisma/client` are pinned to an
  // exact version in package.json.
  previewFeatures = ["relationJoins"]
}

// The finance ledger is a SQL view, "FinanceLedgerView", created by migration
// 20261116090000_finance_ledger and not modelled here (nothing writes it). It
// reads FinanceEntry, Purchase, PurchaseItem, Supplier, AnimalBatch, Invoice,
// InvoiceLine, Customer, CreditNote and CreditNoteLine (each carries a note).
// Migration convention: a migration that renames, retypes or drops a column the
// view reads must DROP VIEW first, change the table, then CREATE VIEW again with
// the same text; `finance-ledger.spec.ts` reads the LAST migration that defines it.
datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  PROPRIETAIRE
  DIRECTEUR_FERME
  RESP_AVICOLE
  RESP_PORCIN
  VETERINAIRE
  RESP_STOCK
  COMPTABLE
  COMMERCIAL
  AGENT_ELEVAGE
  MAGASINIER
  AUDITEUR
}

enum BuildingType {
  AVICOLE
  PORCIN
  AUTRE
}

enum BuildingStatus {
  ACTIF
  VIDE_SANITAIRE
  MAINTENANCE
}

enum Species {
  AVICOLE
  PORCIN
}

enum BatchType {
  CHAIR
  PONDEUSE
  POUSSIN
  REPRODUCTEUR
  PORCELET
  ENGRAISSEMENT
}

enum BatchStatus {
  EN_COURS
  CLOTURE
}

enum BatchEventType {
  /// An additional delivery after the opening count (initialCount); adds to the live count.
  ENTREE
  NAISSANCE
  MORTALITE
  VENTE
  TRANSFERT_SORTIE
  TRANSFERT_ENTREE
  REFORME
}

enum AnimalCategory {
  TRUIE
  VERRAT
  COCHETTE
}

enum AnimalSex {
  F
  M
}

enum AnimalStatus {
  ACTIF
  GESTANTE
  ALLAITANTE
  VENDU
  MORT
  REFORME
}

enum AnimalExitReason {
  VENDU
  MORT
  REFORME
}

enum BreedingMethod {
  SAILLIE
  IA
}

enum BreedingStatus {
  GESTATION
  MISE_BAS
  SEVRAGE
  ECHEC
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  OTHER
}

model Organization {
  id               String            @id @default(cuid())
  name             String
  currency         String            @default("FCFA")
  legalId          String?
  address          String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  farms            Farm[]
  users            User[]
  settings         Setting[]
  auditLogs        AuditLog[]
  breeds           Breed[]
  feedProducts     FeedProduct[]
  feedFormulas     FeedFormula[]
  stockItems       StockItem[]
  suppliers        Supplier[]
  purchases        Purchase[]
  customers        Customer[]
  quotes           Quote[]
  invoices         Invoice[]
  customerPayments CustomerPayment[]
  creditNotes      CreditNote[]
  documentCounters DocumentCounter[]
  vaccinationPlans VaccinationPlan[]
}

model Farm {
  id                String             @id @default(cuid())
  organizationId    String
  organization      Organization       @relation(fields: [organizationId], references: [id])
  name              String
  location          String?
  active            Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  sites             Site[]
  buildings         Building[]
  zones             Zone[]
  userFarms         UserFarm[]
  batches           AnimalBatch[]
  batchEvents       BatchEvent[]
  weighings         Weighing[]
  eggProductions    EggProduction[]
  feedDistributions FeedDistribution[]
  waterConsumptions WaterConsumption[]
  incubations       Incubation[]
  animals           Animal[]
  animalWeighings   AnimalWeighing[]
  heats             Heat[]
  breedingRecords   BreedingRecord[]
  farmStockItems    FarmStockItem[]
  stockBatches      StockBatch[]
  stockMovements    StockMovement[]
  inventories       InventorySession[]
  purchases         Purchase[]
  supplierPayments  SupplierPayment[]
  quotes            Quote[]
  invoices          Invoice[]
  customerPayments  CustomerPayment[]
  creditNotes       CreditNote[]
  financeEntries    FinanceEntry[]
  healthActs        HealthAct[]
  quarantines       Quarantine[]
  healthIncidents   HealthIncident[]
  biosecurityLogs   BiosecurityLog[]
  employees         Employee[]
  attendances       Attendance[]
  tasks             Task[]
}

model Site {
  id        String     @id @default(cuid())
  farmId    String
  farm      Farm       @relation(fields: [farmId], references: [id])
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  buildings Building[]

  @@unique([farmId, name])
}

model Building {
  id                String             @id @default(cuid())
  farmId            String
  farm              Farm               @relation(fields: [farmId], references: [id])
  siteId            String
  site              Site               @relation(fields: [siteId], references: [id])
  name              String
  type              BuildingType
  capacity          Int
  status            BuildingStatus     @default(ACTIF)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  zones             Zone[]
  batches           AnimalBatch[]
  animals           Animal[]
  feedDistributions FeedDistribution[]
  waterConsumptions WaterConsumption[]
  healthActs        HealthAct[]
  tasks             Task[]
  healthIncidents   HealthIncident[]
  biosecurityLogs   BiosecurityLog[]

  @@unique([farmId, name])
  @@index([siteId])
}

model Zone {
  id         String   @id @default(cuid())
  farmId     String
  farm       Farm     @relation(fields: [farmId], references: [id])
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id])
  name       String
  capacity   Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([buildingId, name])
  @@index([farmId])
  @@index([buildingId])
}

model User {
  id                   String             @id @default(cuid())
  organizationId       String
  organization         Organization       @relation(fields: [organizationId], references: [id])
  email                String             @unique
  name                 String
  passwordHash         String
  role                 Role
  active               Boolean            @default(true)
  failedLogins         Int                @default(0)
  lockedUntil          DateTime?
  totpSecretEnc        String?
  totpEnabledAt        DateTime?
  totpLastStep         Int?
  backupCodes          String[]
  lastLoginAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  farms                UserFarm[]
  refreshTokens        RefreshToken[]
  passwordResets       PasswordReset[]
  loginLogs            LoginLog[]
  auditLogs            AuditLog[]
  responsibleFor       AnimalBatch[]
  batchEvents          BatchEvent[]
  stockMovements       StockMovement[]
  inventoriesCreated   InventorySession[] @relation("InventoryCreatedBy")
  inventoriesValidated InventorySession[] @relation("InventoryValidatedBy")
  purchasesRequested   Purchase[]         @relation("PurchaseRequestedBy")
  purchasesValidated   Purchase[]         @relation("PurchaseValidatedBy")
  purchasesOrdered     Purchase[]         @relation("PurchaseOrderedBy")
  employee             Employee[]
  attendancesEntered   Attendance[]
  tasksCreated         Task[]             @relation("TaskCreatedBy")
  tasksCompleted       Task[]             @relation("TaskCompletedBy")
  purchasesReceived    Purchase[]         @relation("PurchaseReceivedBy")
  purchasesCancelled   Purchase[]         @relation("PurchaseCancelledBy")
  supplierPayments     SupplierPayment[]
  healthActs           HealthAct[]
  quotesCreated        Quote[]            @relation("QuoteCreatedBy")
  quotesSent           Quote[]            @relation("QuoteSentBy")
  quotesDecided        Quote[]            @relation("QuoteDecidedBy")
  invoicesCreated      Invoice[]          @relation("InvoiceCreatedBy")
  invoicesIssued       Invoice[]          @relation("InvoiceIssuedBy")
  invoicesCancelled    Invoice[]          @relation("InvoiceCancelledBy")
  customerPayments     CustomerPayment[]
  creditNotes          CreditNote[]
  financeEntries       FinanceEntry[]
}

model UserFarm {
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  farmId    String
  farm      Farm     @relation(fields: [farmId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId, farmId])
  @@index([farmId])
}

model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
}

model LoginLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  email     String
  success   Boolean
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String?
  user           User?        @relation(fields: [userId], references: [id])
  userName       String
  farmId         String?
  module         String
  action         AuditAction
  recordId       String?
  label          String?
  before         Json?
  after          Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([farmId])
  @@index([userId])
}

model Setting {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  key            String
  value          Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, key])
}

model Breed {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  name           String
  species        Species
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  batches        AnimalBatch[]
  animals        Animal[]

  @@unique([organizationId, species, name])
}

enum BatchSourceType {
  HATCH
  FARROWING
}

/// READ BY "FinanceLedgerView" (see the header): changing a column it reads means dropping the view, migrating, recreating it.
model AnimalBatch {
  id                  String             @id @default(cuid())
  farmId              String
  farm                Farm               @relation(fields: [farmId], references: [id])
  code                String
  species             Species
  type                BatchType
  breedId             String?
  breed               Breed?             @relation(fields: [breedId], references: [id], onDelete: Restrict)
  buildingId          String
  building            Building           @relation(fields: [buildingId], references: [id])
  entryDate           DateTime           @db.Date
  initialCount        Int
  supplierName        String?
  purchasePrice       Decimal?           @db.Decimal(14, 2)
  responsibleId       String?
  responsible         User?              @relation(fields: [responsibleId], references: [id], onDelete: Restrict)
  status              BatchStatus        @default(EN_COURS)
  closedAt            DateTime?
  /// What created the batch: a hatch (`sourceId` = incubation) or a farrowing
  /// (`sourceId` = breeding record). Null for a purchased lot. Herd reads it to
  /// freeze the count and entry date of such a batch without importing eggs/breeding.
  sourceType          BatchSourceType?
  sourceId            String?
  /// Sow of a piglet batch.
  motherAnimalId      String?
  mother              Animal?            @relation("SowLitters", fields: [motherAnimalId], references: [id], onDelete: Restrict)
  notes               String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  events              BatchEvent[]       @relation("BatchEvents")
  relatedEvents       BatchEvent[]       @relation("RelatedBatch")
  weighings           Weighing[]
  eggProductions      EggProduction[]
  feedDistributions   FeedDistribution[]
  waterConsumptions   WaterConsumption[]
  sourceOfIncubations Incubation[]       @relation("IncubationSource")
  hatchedFrom         Incubation?        @relation("IncubationChicks")
  litterOf            BreedingRecord?    @relation("BreedingLitter")
  healthActs          HealthAct[]
  tasks               Task[]
  quarantines         Quarantine[]
  healthIncidents     HealthIncident[]
  quoteLines          QuoteLine[]
  invoiceLines        InvoiceLine[]
  financeEntries      FinanceEntry[]

  @@unique([farmId, code])
  @@index([farmId])
  @@index([breedId])
  @@index([buildingId])
  @@index([responsibleId])
  @@index([motherAnimalId])
}

model BatchEvent {
  id             String         @id @default(cuid())
  farmId         String
  farm           Farm           @relation(fields: [farmId], references: [id])
  batchId        String
  batch          AnimalBatch    @relation("BatchEvents", fields: [batchId], references: [id])
  date           DateTime       @db.Date
  type           BatchEventType
  quantity       Int
  cause          String?
  note           String?
  relatedBatchId String?
  relatedBatch   AnimalBatch?   @relation("RelatedBatch", fields: [relatedBatchId], references: [id], onDelete: Restrict)
  sourceType     String?
  sourceId       String?
  createdById    String
  createdBy      User           @relation(fields: [createdById], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([farmId])
  @@index([batchId, date])
  @@index([relatedBatchId])
  @@index([sourceType, sourceId])
  @@index([createdById])
}

model Weighing {
  id             String      @id @default(cuid())
  farmId         String
  farm           Farm        @relation(fields: [farmId], references: [id])
  batchId        String
  batch          AnimalBatch @relation(fields: [batchId], references: [id])
  date           DateTime    @db.Date
  sampleSize     Int
  averageWeightG Int
  note           String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([farmId])
  @@index([batchId, date])
}

enum IncubationStatus {
  EN_COURS
  ECLOSE
  ECHEC
}

model EggProduction {
  id           String      @id @default(cuid())
  farmId       String
  farm         Farm        @relation(fields: [farmId], references: [id])
  batchId      String
  batch        AnimalBatch @relation(fields: [batchId], references: [id])
  date         DateTime    @db.Date
  collected    Int
  broken       Int         @default(0)
  downgraded   Int         @default(0)
  toIncubation Int         @default(0)
  note         String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([batchId, date])
  @@index([farmId])
  @@index([farmId, date])
}

model Incubation {
  id                String           @id @default(cuid())
  farmId            String
  farm              Farm             @relation(fields: [farmId], references: [id])
  code              String
  sourceBatchId     String?
  sourceBatch       AnimalBatch?     @relation("IncubationSource", fields: [sourceBatchId], references: [id], onDelete: Restrict)
  incubator         String?
  startDate         DateTime         @db.Date
  eggsSet           Int
  candlingDate      DateTime?        @db.Date
  fertileEggs       Int?
  expectedHatchDate DateTime         @db.Date
  status            IncubationStatus @default(EN_COURS)
  hatchDate         DateTime?        @db.Date
  chicksHatched     Int?
  chickBatchId      String?          @unique
  chickBatch        AnimalBatch?     @relation("IncubationChicks", fields: [chickBatchId], references: [id], onDelete: Restrict)
  note              String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([farmId, code])
  @@index([farmId])
  @@index([sourceBatchId])
}

model Animal {
  id              String            @id @default(cuid())
  farmId          String
  farm            Farm              @relation(fields: [farmId], references: [id])
  tag             String
  category        AnimalCategory
  breedId         String?
  breed           Breed?            @relation(fields: [breedId], references: [id], onDelete: Restrict)
  sex             AnimalSex
  birthDate       DateTime?         @db.Date
  sireId          String?
  sire            Animal?           @relation("Sire", fields: [sireId], references: [id], onDelete: Restrict)
  damId           String?
  dam             Animal?           @relation("Dam", fields: [damId], references: [id], onDelete: Restrict)
  buildingId      String
  building        Building          @relation(fields: [buildingId], references: [id])
  status          AnimalStatus      @default(ACTIF)
  exitDate        DateTime?         @db.Date
  exitReason      AnimalExitReason?
  /// What sold the animal (`SALE` + the invoice id, `exitSourceLabel` = its number): set only with `exitReason = VENDU`, together or not at all.
  exitSourceType  String?
  exitSourceId    String?
  exitSourceLabel String?
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  sired           Animal[]          @relation("Sire")
  born            Animal[]          @relation("Dam")
  weighings       AnimalWeighing[]
  heats           Heat[]
  breedings       BreedingRecord[]  @relation("BreedingSow")
  services        BreedingRecord[]  @relation("BreedingBoar")
  litters         AnimalBatch[]     @relation("SowLitters")
  healthActs      HealthAct[]
  quarantines     Quarantine[]
  quoteLines      QuoteLine[]
  invoiceLines    InvoiceLine[]

  @@unique([farmId, tag])
  @@index([farmId])
  @@index([breedId])
  @@index([sireId])
  @@index([damId])
  @@index([buildingId])
  @@index([exitSourceType, exitSourceId])
}

model AnimalWeighing {
  id        String   @id @default(cuid())
  farmId    String
  farm      Farm     @relation(fields: [farmId], references: [id])
  animalId  String
  animal    Animal   @relation(fields: [animalId], references: [id])
  date      DateTime @db.Date
  weightKg  Decimal  @db.Decimal(6, 1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([farmId])
  @@index([animalId, date])
}

model Heat {
  id        String   @id @default(cuid())
  farmId    String
  farm      Farm     @relation(fields: [farmId], references: [id])
  animalId  String
  animal    Animal   @relation(fields: [animalId], references: [id])
  date      DateTime @db.Date
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([farmId])
  @@index([animalId, date])
}

model BreedingRecord {
  id                    String         @id @default(cuid())
  farmId                String
  farm                  Farm           @relation(fields: [farmId], references: [id])
  sowId                 String
  sow                   Animal         @relation("BreedingSow", fields: [sowId], references: [id])
  method                BreedingMethod
  boarId                String?
  boar                  Animal?        @relation("BreedingBoar", fields: [boarId], references: [id], onDelete: Restrict)
  semenLabel            String?
  serviceDate           DateTime       @db.Date
  expectedFarrowingDate DateTime       @db.Date
  status                BreedingStatus @default(GESTATION)
  farrowingDate         DateTime?      @db.Date
  bornTotal             Int?
  bornAlive             Int?
  stillborn             Int?
  litterBatchId         String?        @unique
  litterBatch           AnimalBatch?   @relation("BreedingLitter", fields: [litterBatchId], references: [id], onDelete: Restrict)
  weaningDate           DateTime?      @db.Date
  /// The moment the weaning was recorded: it has a position in its day, like a ledger operation.
  weanedAt              DateTime?
  weanedCount           Int?
  failureDate           DateTime?      @db.Date
  note                  String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([farmId])
  @@index([farmId, serviceDate])
  @@index([sowId])
  @@index([boarId])
}

enum FeedKind {
  MATIERE_PREMIERE
  ALIMENT_COMPLET
}

model FeedProduct {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id])
  name           String
  kind           FeedKind
  unit           String             @default("kg")
  unitCost       Decimal            @db.Decimal(12, 2)
  active         Boolean            @default(true)
  /// The stock article this feed is drawn from (category ALIMENT, kg); null = no stock, the catalogue price applies.
  stockItemId    String?            @unique
  stockItem      StockItem?         @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  formulaItems   FeedFormulaItem[]
  distributions  FeedDistribution[]

  @@unique([organizationId, name])
}

model FeedFormula {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id])
  name           String
  species        Species
  stage          String
  active         Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  items          FeedFormulaItem[]
  distributions  FeedDistribution[]

  @@unique([organizationId, name])
}

model FeedFormulaItem {
  id            String      @id @default(cuid())
  formulaId     String
  formula       FeedFormula @relation(fields: [formulaId], references: [id], onDelete: Cascade)
  feedProductId String
  feedProduct   FeedProduct @relation(fields: [feedProductId], references: [id], onDelete: Restrict)
  percentage    Decimal     @db.Decimal(5, 2)

  @@unique([formulaId, feedProductId])
  @@index([feedProductId])
}

model FeedDistribution {
  id            String       @id @default(cuid())
  farmId        String
  farm          Farm         @relation(fields: [farmId], references: [id])
  date          DateTime     @db.Date
  batchId       String?
  batch         AnimalBatch? @relation(fields: [batchId], references: [id], onDelete: Restrict)
  buildingId    String?
  building      Building?    @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  feedProductId String?
  feedProduct   FeedProduct? @relation(fields: [feedProductId], references: [id], onDelete: Restrict)
  formulaId     String?
  formula       FeedFormula? @relation(fields: [formulaId], references: [id], onDelete: Restrict)
  quantityKg    Decimal      @db.Decimal(10, 2)
  /// SNAPSHOT written at entry time (product cost, or formula cost per kg; for stock-linked feed, what the ledger valued the exits at that moment). Later price changes never rewrite it, and neither does the ledger when it re-costs exits: what the screens show is the CURRENT cost (see FeedService.currentCosts): the ledger's exits for the stock-valued part plus `unlinkedCost`.
  unitCost      Decimal      @db.Decimal(12, 2)
  /// SNAPSHOT of the whole cost at entry time (stock-valued part + `unlinkedCost`).
  cost          Decimal      @db.Decimal(14, 2)
  /// The part of the cost that is NOT valued by the stock ledger: unlinked ingredients at their catalogue price x share, as written at entry (exact, 4 decimals). 0 for a feed fully linked to stock.
  unlinkedCost  Decimal      @default(0) @db.Decimal(16, 4)
  note          String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([farmId])
  @@index([farmId, date])
  @@index([batchId])
  @@index([buildingId])
  @@index([feedProductId])
  @@index([formulaId])
}

model WaterConsumption {
  id         String       @id @default(cuid())
  farmId     String
  farm       Farm         @relation(fields: [farmId], references: [id])
  date       DateTime     @db.Date
  batchId    String?
  batch      AnimalBatch? @relation(fields: [batchId], references: [id], onDelete: Restrict)
  buildingId String?
  building   Building?    @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  liters     Decimal      @db.Decimal(10, 2)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([batchId, date])
  @@unique([buildingId, date])
  @@index([farmId])
  @@index([farmId, date])
  @@index([batchId])
  @@index([buildingId])
}

enum StockCategory {
  ALIMENT
  MEDICAMENT
  VACCIN
  MATERIEL
  CONSOMMABLE
}

enum StockMovementType {
  ENTREE
  SORTIE
  AJUSTEMENT
  /// Reserved: one stock per farm, no route writes a transfer.
  TRANSFERT_SORTIE
  TRANSFERT_ENTREE
}

enum StockReason {
  ACHAT
  CONSOMMATION
  TRAITEMENT
  INVENTAIRE
  PERTE
  AUTRE
  /// A sale of stock (invoice line): an exit at the running average cost.
  VENTE
  /// Goods returned by a customer (credit note with return): an entry at the sale's cost.
  RETOUR
}

enum InventoryStatus {
  BROUILLON
  VALIDEE
}

/// An article of the organisation's catalogue; its quantity per farm is the sum of that farm's movements.
model StockItem {
  id             String                @id @default(cuid())
  organizationId String
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String
  category       StockCategory
  unit           String
  active         Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  farmItems      FarmStockItem[]
  batches        StockBatch[]
  movements      StockMovement[]
  inventoryLines InventoryLine[]
  feedProduct    FeedProduct?
  purchaseItems  PurchaseItem[]
  quoteLines     QuoteLine[]
  invoiceLines   InvoiceLine[]
  healthActs     HealthAct[]
  planItems      VaccinationPlanItem[]

  @@unique([organizationId, name])
}

/// The thresholds of one article in one farm; also the row lock that serialises every change to that (farm, article) stock.
model FarmStockItem {
  id          String    @id @default(cuid())
  farmId      String
  farm        Farm      @relation(fields: [farmId], references: [id], onDelete: Restrict)
  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  minQty      Decimal   @default(0) @db.Decimal(12, 2)
  maxQty      Decimal?  @db.Decimal(12, 2)
  /// Cache of the ledger replay, written by the stock ledger under this row's lock at every commit: the sum of the pair's movements.
  quantity    Decimal   @default(0) @db.Decimal(14, 2)
  /// Cache of the weighted-average cost at full replay precision. NULL = not computed yet (rows that predate the cache): readers replay such a pair, the next write persists it.
  averageCost Decimal?  @db.Decimal(40, 20)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([farmId, stockItemId])
  @@index([farmId])
  @@index([stockItemId])
}

/// A lot received (one per reception line); its quantity is the sum of the movements that carry it.
model StockBatch {
  id           String          @id @default(cuid())
  farmId       String
  farm         Farm            @relation(fields: [farmId], references: [id], onDelete: Restrict)
  stockItemId  String
  stockItem    StockItem       @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  lotNumber    String?
  expiryDate   DateTime?       @db.Date
  receivedDate DateTime        @db.Date
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  movements    StockMovement[]
  healthActs   HealthAct[]

  @@index([farmId])
  @@index([stockItemId])
  @@index([farmId, stockItemId])
}

model StockMovement {
  id           String            @id @default(cuid())
  farmId       String
  farm         Farm              @relation(fields: [farmId], references: [id], onDelete: Restrict)
  stockItemId  String
  stockItem    StockItem         @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  stockBatchId String?
  stockBatch   StockBatch?       @relation(fields: [stockBatchId], references: [id], onDelete: Restrict)
  date         DateTime          @db.Date
  type         StockMovementType
  /// Signed: positive in, negative out.
  quantity     Decimal           @db.Decimal(12, 2)
  /// An entry's own cost; for an exit, the weighted-average cost at that point of the history (rewritten when the history changes).
  unitCost     Decimal           @db.Decimal(12, 2)
  reason       StockReason
  /// The operation that wrote it (FEED_DISTRIBUTION, HEALTH_ACT, PURCHASE, INVENTORY...); null for a hand-entered movement.
  sourceType   String?
  sourceId     String?
  /// Shared by the pieces of one operation (FEFO may split an exit across lots); a movement written alone carries its own id.
  operationId  String
  /// The exit was asked from this very lot (not picked by FEFO): an edit keeps it on that lot.
  lotExplicit  Boolean           @default(false)
  note         String?
  createdById  String
  createdBy    User              @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([farmId])
  @@index([stockItemId])
  @@index([stockBatchId])
  @@index([createdById])
  @@index([farmId, stockItemId, date])
  @@index([sourceType, sourceId])
  @@index([operationId])
}

model InventorySession {
  id            String          @id @default(cuid())
  farmId        String
  farm          Farm            @relation(fields: [farmId], references: [id], onDelete: Restrict)
  date          DateTime        @db.Date
  status        InventoryStatus @default(BROUILLON)
  note          String?
  createdById   String
  createdBy     User            @relation("InventoryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  validatedById String?
  validatedBy   User?           @relation("InventoryValidatedBy", fields: [validatedById], references: [id], onDelete: Restrict)
  validatedAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  lines         InventoryLine[]

  @@index([farmId])
  @@index([createdById])
  @@index([validatedById])
}

model InventoryLine {
  id             String           @id @default(cuid())
  sessionId      String
  session        InventorySession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  stockItemId    String
  stockItem      StockItem        @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  theoreticalQty Decimal          @db.Decimal(12, 2)
  countedQty     Decimal          @db.Decimal(12, 2)

  @@unique([sessionId, stockItemId])
  @@index([stockItemId])
}

enum PurchaseStatus {
  DEMANDE
  VALIDEE
  COMMANDEE
  RECUE
  PAYEE
  ANNULEE
}

enum PaymentMethod {
  ESPECES
  VIREMENT
  MOBILE_MONEY
  CHEQUE
}

/// Organisation master data (not farm-scoped).
/// READ BY "FinanceLedgerView" (see the header): changing a column it reads means dropping the view, migrating, recreating it.
model Supplier {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String
  products       String?
  phone          String?
  email          String?
  address        String?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  purchases      Purchase[]

  @@unique([organizationId, name])
