generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  PROPRIETAIRE
  DIRECTEUR_FERME
  RESP_AVICOLE
  RESP_PORCIN
  VETERINAIRE
  RESP_STOCK
  COMPTABLE
  COMMERCIAL
  AGENT_ELEVAGE
  MAGASINIER
  AUDITEUR
}

enum BuildingType {
  AVICOLE
  PORCIN
  AUTRE
}

enum BuildingStatus {
  ACTIF
  VIDE_SANITAIRE
  MAINTENANCE
}

enum Species {
  AVICOLE
  PORCIN
}

enum BatchType {
  CHAIR
  PONDEUSE
  POUSSIN
  REPRODUCTEUR
  PORCELET
  ENGRAISSEMENT
}

enum BatchStatus {
  EN_COURS
  CLOTURE
}

enum BatchEventType {
  /// An additional delivery after the opening count (initialCount); adds to the live count.
  ENTREE
  NAISSANCE
  MORTALITE
  VENTE
  TRANSFERT_SORTIE
  TRANSFERT_ENTREE
  REFORME
}

enum AnimalCategory {
  TRUIE
  VERRAT
  COCHETTE
}

enum AnimalSex {
  F
  M
}

enum AnimalStatus {
  ACTIF
  GESTANTE
  ALLAITANTE
  VENDU
  MORT
  REFORME
}

enum AnimalExitReason {
  VENDU
  MORT
  REFORME
}

enum BreedingMethod {
  SAILLIE
  IA
}

enum BreedingStatus {
  GESTATION
  MISE_BAS
  SEVRAGE
  ECHEC
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  OTHER
}

model Organization {
  id           String        @id @default(cuid())
  name         String
  currency     String        @default("FCFA")
  legalId      String?
  address      String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  farms        Farm[]
  users        User[]
  settings     Setting[]
  auditLogs    AuditLog[]
  breeds       Breed[]
  feedProducts FeedProduct[]
  feedFormulas FeedFormula[]
}

model Farm {
  id                String             @id @default(cuid())
  organizationId    String
  organization      Organization       @relation(fields: [organizationId], references: [id])
  name              String
  location          String?
  active            Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  sites             Site[]
  buildings         Building[]
  zones             Zone[]
  userFarms         UserFarm[]
  batches           AnimalBatch[]
  batchEvents       BatchEvent[]
  weighings         Weighing[]
  eggProductions    EggProduction[]
  feedDistributions FeedDistribution[]
  waterConsumptions WaterConsumption[]
  incubations       Incubation[]
  animals           Animal[]
  animalWeighings   AnimalWeighing[]
  heats             Heat[]
  breedingRecords   BreedingRecord[]
}

model Site {
  id        String     @id @default(cuid())
  farmId    String
  farm      Farm       @relation(fields: [farmId], references: [id])
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  buildings Building[]

  @@unique([farmId, name])
}

model Building {
  id                String             @id @default(cuid())
  farmId            String
  farm              Farm               @relation(fields: [farmId], references: [id])
  siteId            String
  site              Site               @relation(fields: [siteId], references: [id])
  name              String
  type              BuildingType
  capacity          Int
  status            BuildingStatus     @default(ACTIF)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  zones             Zone[]
  batches           AnimalBatch[]
  animals           Animal[]
  feedDistributions FeedDistribution[]
  waterConsumptions WaterConsumption[]

  @@unique([farmId, name])
  @@index([siteId])
}

model Zone {
  id         String   @id @default(cuid())
  farmId     String
  farm       Farm     @relation(fields: [farmId], references: [id])
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id])
  name       String
  capacity   Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([buildingId, name])
  @@index([farmId])
  @@index([buildingId])
}

model User {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  email          String          @unique
  name           String
  passwordHash   String
  role           Role
  active         Boolean         @default(true)
  failedLogins   Int             @default(0)
  lockedUntil    DateTime?
  totpSecretEnc  String?
  totpEnabledAt  DateTime?
  totpLastStep   Int?
  backupCodes    String[]
  lastLoginAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  farms          UserFarm[]
  refreshTokens  RefreshToken[]
  passwordResets PasswordReset[]
  loginLogs      LoginLog[]
  auditLogs      AuditLog[]
  responsibleFor AnimalBatch[]
  batchEvents    BatchEvent[]
}

model UserFarm {
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  farmId    String
  farm      Farm     @relation(fields: [farmId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId, farmId])
  @@index([farmId])
}

model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
}

model LoginLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  email     String
  success   Boolean
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String?
  user           User?        @relation(fields: [userId], references: [id])
  userName       String
  farmId         String?
  module         String
  action         AuditAction
  recordId       String?
  label          String?
  before         Json?
  after          Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([farmId])
  @@index([userId])
}

model Setting {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  key            String
  value          Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, key])
}

model Breed {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  name           String
  species        Species
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  batches        AnimalBatch[]
  animals        Animal[]

  @@unique([organizationId, species, name])
}

model AnimalBatch {
  id                  String             @id @default(cuid())
  farmId              String
  farm                Farm               @relation(fields: [farmId], references: [id])
  code                String
  species             Species
  type                BatchType
  breedId             String?
  breed               Breed?             @relation(fields: [breedId], references: [id], onDelete: Restrict)
  buildingId          String
  building            Building           @relation(fields: [buildingId], references: [id])
  entryDate           DateTime           @db.Date
  initialCount        Int
  supplierName        String?
  purchasePrice       Decimal?           @db.Decimal(14, 2)
  responsibleId       String?
  responsible         User?              @relation(fields: [responsibleId], references: [id], onDelete: Restrict)
  status              BatchStatus        @default(EN_COURS)
  closedAt            DateTime?
  /// Sow of a piglet batch.
  motherAnimalId      String?
  mother              Animal?            @relation("SowLitters", fields: [motherAnimalId], references: [id], onDelete: Restrict)
  notes               String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  events              BatchEvent[]       @relation("BatchEvents")
  relatedEvents       BatchEvent[]       @relation("RelatedBatch")
  weighings           Weighing[]
  eggProductions      EggProduction[]
  feedDistributions   FeedDistribution[]
  waterConsumptions   WaterConsumption[]
  sourceOfIncubations Incubation[]       @relation("IncubationSource")
  hatchedFrom         Incubation?        @relation("IncubationChicks")
  litterOf            BreedingRecord?    @relation("BreedingLitter")

  @@unique([farmId, code])
  @@index([farmId])
  @@index([breedId])
  @@index([buildingId])
  @@index([responsibleId])
  @@index([motherAnimalId])
}

model BatchEvent {
  id             String         @id @default(cuid())
  farmId         String
  farm           Farm           @relation(fields: [farmId], references: [id])
  batchId        String
  batch          AnimalBatch    @relation("BatchEvents", fields: [batchId], references: [id])
  date           DateTime       @db.Date
  type           BatchEventType
  quantity       Int
  cause          String?
  note           String?
  relatedBatchId String?
  relatedBatch   AnimalBatch?   @relation("RelatedBatch", fields: [relatedBatchId], references: [id], onDelete: Restrict)
  sourceType     String?
  sourceId       String?
  createdById    String
  createdBy      User           @relation(fields: [createdById], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([farmId])
  @@index([batchId, date])
  @@index([relatedBatchId])
  @@index([createdById])
}

model Weighing {
  id             String      @id @default(cuid())
  farmId         String
  farm           Farm        @relation(fields: [farmId], references: [id])
  batchId        String
  batch          AnimalBatch @relation(fields: [batchId], references: [id])
  date           DateTime    @db.Date
  sampleSize     Int
  averageWeightG Int
  note           String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([farmId])
  @@index([batchId, date])
}

enum IncubationStatus {
  EN_COURS
  ECLOSE
  ECHEC
}

model EggProduction {
  id           String      @id @default(cuid())
  farmId       String
  farm         Farm        @relation(fields: [farmId], references: [id])
  batchId      String
  batch        AnimalBatch @relation(fields: [batchId], references: [id])
  date         DateTime    @db.Date
  collected    Int
  broken       Int         @default(0)
  downgraded   Int         @default(0)
  toIncubation Int         @default(0)
  note         String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([batchId, date])
  @@index([farmId])
  @@index([farmId, date])
}

model Incubation {
  id                String           @id @default(cuid())
  farmId            String
  farm              Farm             @relation(fields: [farmId], references: [id])
  code              String
  sourceBatchId     String?
  sourceBatch       AnimalBatch?     @relation("IncubationSource", fields: [sourceBatchId], references: [id], onDelete: Restrict)
  incubator         String?
  startDate         DateTime         @db.Date
  eggsSet           Int
  candlingDate      DateTime?        @db.Date
  fertileEggs       Int?
  expectedHatchDate DateTime         @db.Date
  status            IncubationStatus @default(EN_COURS)
  hatchDate         DateTime?        @db.Date
  chicksHatched     Int?
  chickBatchId      String?          @unique
  chickBatch        AnimalBatch?     @relation("IncubationChicks", fields: [chickBatchId], references: [id], onDelete: Restrict)
  note              String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([farmId, code])
  @@index([farmId])
  @@index([sourceBatchId])
}

model Animal {
  id         String            @id @default(cuid())
  farmId     String
  farm       Farm              @relation(fields: [farmId], references: [id])
  tag        String
  category   AnimalCategory
  breedId    String?
  breed      Breed?            @relation(fields: [breedId], references: [id], onDelete: Restrict)
  sex        AnimalSex
  birthDate  DateTime?         @db.Date
  sireId     String?
  sire       Animal?           @relation("Sire", fields: [sireId], references: [id], onDelete: Restrict)
  damId      String?
  dam        Animal?           @relation("Dam", fields: [damId], references: [id], onDelete: Restrict)
  buildingId String
  building   Building          @relation(fields: [buildingId], references: [id])
  status     AnimalStatus      @default(ACTIF)
  exitDate   DateTime?         @db.Date
  exitReason AnimalExitReason?
  notes      String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  sired      Animal[]          @relation("Sire")
  born       Animal[]          @relation("Dam")
  weighings  AnimalWeighing[]
  heats      Heat[]
  breedings  BreedingRecord[]  @relation("BreedingSow")
  services   BreedingRecord[]  @relation("BreedingBoar")
  litters    AnimalBatch[]     @relation("SowLitters")

  @@unique([farmId, tag])
  @@index([farmId])
  @@index([breedId])
  @@index([sireId])
  @@index([damId])
  @@index([buildingId])
}

model AnimalWeighing {
  id        String   @id @default(cuid())
  farmId    String
  farm      Farm     @relation(fields: [farmId], references: [id])
  animalId  String
  animal    Animal   @relation(fields: [animalId], references: [id])
  date      DateTime @db.Date
  weightKg  Decimal  @db.Decimal(6, 1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([farmId])
  @@index([animalId, date])
}

model Heat {
  id        String   @id @default(cuid())
  farmId    String
  farm      Farm     @relation(fields: [farmId], references: [id])
  animalId  String
  animal    Animal   @relation(fields: [animalId], references: [id])
  date      DateTime @db.Date
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([farmId])
  @@index([animalId, date])
}

model BreedingRecord {
  id                    String         @id @default(cuid())
  farmId                String
  farm                  Farm           @relation(fields: [farmId], references: [id])
  sowId                 String
  sow                   Animal         @relation("BreedingSow", fields: [sowId], references: [id])
  method                BreedingMethod
  boarId                String?
  boar                  Animal?        @relation("BreedingBoar", fields: [boarId], references: [id], onDelete: Restrict)
  semenLabel            String?
  serviceDate           DateTime       @db.Date
  expectedFarrowingDate DateTime       @db.Date
  status                BreedingStatus @default(GESTATION)
  farrowingDate         DateTime?      @db.Date
  bornTotal             Int?
  bornAlive             Int?
  stillborn             Int?
  litterBatchId         String?        @unique
  litterBatch           AnimalBatch?   @relation("BreedingLitter", fields: [litterBatchId], references: [id], onDelete: Restrict)
  weaningDate           DateTime?      @db.Date
  weanedCount           Int?
  failureDate           DateTime?      @db.Date
  note                  String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([farmId])
  @@index([farmId, serviceDate])
  @@index([sowId])
  @@index([boarId])
}

enum FeedKind {
  MATIERE_PREMIERE
  ALIMENT_COMPLET
}

model FeedProduct {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id])
  name           String
  kind           FeedKind
  unit           String             @default("kg")
  unitCost       Decimal            @db.Decimal(12, 2)
  active         Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  formulaItems   FeedFormulaItem[]
  distributions  FeedDistribution[]

  @@unique([organizationId, name])
}

model FeedFormula {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id])
  name           String
  species        Species
  stage          String
  active         Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  items          FeedFormulaItem[]
  distributions  FeedDistribution[]

  @@unique([organizationId, name])
}

model FeedFormulaItem {
  id            String      @id @default(cuid())
  formulaId     String
  formula       FeedFormula @relation(fields: [formulaId], references: [id], onDelete: Cascade)
  feedProductId String
  feedProduct   FeedProduct @relation(fields: [feedProductId], references: [id], onDelete: Restrict)
  percentage    Decimal     @db.Decimal(5, 2)

  @@unique([formulaId, feedProductId])
  @@index([feedProductId])
}

model FeedDistribution {
  id            String       @id @default(cuid())
  farmId        String
  farm          Farm         @relation(fields: [farmId], references: [id])
  date          DateTime     @db.Date
  batchId       String?
  batch         AnimalBatch? @relation(fields: [batchId], references: [id])
  buildingId    String?
  building      Building?    @relation(fields: [buildingId], references: [id])
  feedProductId String?
  feedProduct   FeedProduct? @relation(fields: [feedProductId], references: [id], onDelete: Restrict)
  formulaId     String?
  formula       FeedFormula? @relation(fields: [formulaId], references: [id], onDelete: Restrict)
  quantityKg    Decimal      @db.Decimal(10, 2)
  /// Copied at entry time (product cost, or formula cost per kg): later price changes never rewrite history.
  unitCost      Decimal      @db.Decimal(12, 2)
  cost          Decimal      @db.Decimal(14, 2)
  note          String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([farmId])
  @@index([farmId, date])
  @@index([batchId])
  @@index([buildingId])
  @@index([feedProductId])
  @@index([formulaId])
}

model WaterConsumption {
  id         String       @id @default(cuid())
  farmId     String
  farm       Farm         @relation(fields: [farmId], references: [id])
  date       DateTime     @db.Date
  batchId    String?
  batch      AnimalBatch? @relation(fields: [batchId], references: [id])
  buildingId String?
  building   Building?    @relation(fields: [buildingId], references: [id])
  liters     Decimal      @db.Decimal(10, 2)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([batchId, date])
  @@unique([buildingId, date])
  @@index([farmId])
  @@index([farmId, date])
  @@index([batchId])
  @@index([buildingId])
}
