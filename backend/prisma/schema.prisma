generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  PROPRIETAIRE
  DIRECTEUR_FERME
  RESP_AVICOLE
  RESP_PORCIN
  VETERINAIRE
  RESP_STOCK
  COMPTABLE
  COMMERCIAL
  AGENT_ELEVAGE
  MAGASINIER
  AUDITEUR
}

enum BuildingType {
  AVICOLE
  PORCIN
  AUTRE
}

enum BuildingStatus {
  ACTIF
  VIDE_SANITAIRE
  MAINTENANCE
}

enum Species {
  AVICOLE
  PORCIN
}

enum BatchType {
  CHAIR
  PONDEUSE
  POUSSIN
  REPRODUCTEUR
  PORCELET
  ENGRAISSEMENT
}

enum BatchStatus {
  EN_COURS
  CLOTURE
}

enum BatchEventType {
  /// An additional delivery after the opening count (initialCount); adds to the live count.
  ENTREE
  NAISSANCE
  MORTALITE
  VENTE
  TRANSFERT_SORTIE
  TRANSFERT_ENTREE
  REFORME
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  OTHER
}

model Organization {
  id        String     @id @default(cuid())
  name      String
  currency  String     @default("FCFA")
  legalId   String?
  address   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  farms     Farm[]
  users     User[]
  settings  Setting[]
  auditLogs AuditLog[]
  breeds    Breed[]
}

model Farm {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  name           String
  location       String?
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  sites          Site[]
  buildings      Building[]
  zones          Zone[]
  userFarms      UserFarm[]
  batches        AnimalBatch[]
  batchEvents    BatchEvent[]
  weighings      Weighing[]
}

model Site {
  id        String     @id @default(cuid())
  farmId    String
  farm      Farm       @relation(fields: [farmId], references: [id])
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  buildings Building[]

  @@unique([farmId, name])
}

model Building {
  id        String         @id @default(cuid())
  farmId    String
  farm      Farm           @relation(fields: [farmId], references: [id])
  siteId    String
  site      Site           @relation(fields: [siteId], references: [id])
  name      String
  type      BuildingType
  capacity  Int
  status    BuildingStatus @default(ACTIF)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  zones     Zone[]
  batches   AnimalBatch[]

  @@unique([farmId, name])
  @@index([siteId])
}

model Zone {
  id         String   @id @default(cuid())
  farmId     String
  farm       Farm     @relation(fields: [farmId], references: [id])
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id])
  name       String
  capacity   Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([buildingId, name])
  @@index([farmId])
  @@index([buildingId])
}

model User {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  email          String          @unique
  name           String
  passwordHash   String
  role           Role
  active         Boolean         @default(true)
  failedLogins   Int             @default(0)
  lockedUntil    DateTime?
  totpSecretEnc  String?
  totpEnabledAt  DateTime?
  totpLastStep   Int?
  backupCodes    String[]
  lastLoginAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  farms          UserFarm[]
  refreshTokens  RefreshToken[]
  passwordResets PasswordReset[]
  loginLogs      LoginLog[]
  auditLogs      AuditLog[]
  responsibleFor AnimalBatch[]
  batchEvents    BatchEvent[]
}

model UserFarm {
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  farmId    String
  farm      Farm     @relation(fields: [farmId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId, farmId])
  @@index([farmId])
}

model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
}

model LoginLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  email     String
  success   Boolean
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String?
  user           User?        @relation(fields: [userId], references: [id])
  userName       String
  farmId         String?
  module         String
  action         AuditAction
  recordId       String?
  label          String?
  before         Json?
  after          Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([farmId])
  @@index([userId])
}

model Setting {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  key            String
  value          Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, key])
}

model Breed {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  name           String
  species        Species
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  batches        AnimalBatch[]

  @@unique([organizationId, species, name])
}

model AnimalBatch {
  id             String       @id @default(cuid())
  farmId         String
  farm           Farm         @relation(fields: [farmId], references: [id])
  code           String
  species        Species
  type           BatchType
  breedId        String?
  breed          Breed?       @relation(fields: [breedId], references: [id], onDelete: Restrict)
  buildingId     String
  building       Building     @relation(fields: [buildingId], references: [id])
  entryDate      DateTime     @db.Date
  initialCount   Int
  supplierName   String?
  purchasePrice  Decimal?     @db.Decimal(14, 2)
  responsibleId  String?
  responsible    User?        @relation(fields: [responsibleId], references: [id], onDelete: Restrict)
  status         BatchStatus  @default(EN_COURS)
  closedAt       DateTime?
  /// Sow of a piglet batch; the animals table (and its foreign key) arrive with the pig module.
  motherAnimalId String?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  events         BatchEvent[] @relation("BatchEvents")
  relatedEvents  BatchEvent[] @relation("RelatedBatch")
  weighings      Weighing[]

  @@unique([farmId, code])
  @@index([farmId])
  @@index([breedId])
  @@index([buildingId])
  @@index([responsibleId])
}

model BatchEvent {
  id             String         @id @default(cuid())
  farmId         String
  farm           Farm           @relation(fields: [farmId], references: [id])
  batchId        String
  batch          AnimalBatch    @relation("BatchEvents", fields: [batchId], references: [id])
  date           DateTime       @db.Date
  type           BatchEventType
  quantity       Int
  cause          String?
  note           String?
  relatedBatchId String?
  relatedBatch   AnimalBatch?   @relation("RelatedBatch", fields: [relatedBatchId], references: [id], onDelete: Restrict)
  sourceType     String?
  sourceId       String?
  createdById    String
  createdBy      User           @relation(fields: [createdById], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([farmId])
  @@index([batchId, date])
  @@index([relatedBatchId])
  @@index([createdById])
}

model Weighing {
  id             String      @id @default(cuid())
  farmId         String
  farm           Farm        @relation(fields: [farmId], references: [id])
  batchId        String
  batch          AnimalBatch @relation(fields: [batchId], references: [id])
  date           DateTime    @db.Date
  sampleSize     Int
  averageWeightG Int
  note           String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([farmId])
  @@index([batchId, date])
}
