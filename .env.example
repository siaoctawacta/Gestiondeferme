# Copy to `.env` (never commit it) and fill in every value. Read by docker-compose.yml.

# Password of the PostgreSQL role `agripilot` (any strong password; no @ : / characters).
POSTGRES_PASSWORD=

# At least 32 random characters:   openssl rand -base64 48
JWT_SECRET=

# Exactly 32 bytes, base64 or hex encoded:   openssl rand -base64 32
TOTP_ENC_KEY=

# Public URL of the web app, exactly as typed in the browser (used for CORS).
WEB_ORIGIN=http://localhost:8080

# Number of reverse proxies in front of the API, for client-IP detection (rate limiting).
# 1 = only the bundled nginx (web container). Set 2 when another reverse proxy
# (Caddy, Traefik...) sits in front of the web container.
TRUST_PROXY=1

# First administrator, used only by the explicit seed command (see README):
#   docker compose run --rm api npx prisma db seed
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Address encoded in the QR labels (`{APP_URL}/q/{kind}/{id}`); leave empty to use WEB_ORIGIN.
APP_URL=

# Demo farm « Ferme Kpalimé » (evaluation installs only, see README):
#   docker compose run --rm api node dist-demo/prisma/demo/seed-demo.js
# The API runs in production mode: the demo needs ALLOW_DEMO_SEED=1, and it creates 12 accounts (a second
# super administrator included) that must be deleted before real use. Forced in production, the demo needs a
# DEMO_PASSWORD of 16 characters or more.
DEMO_PASSWORD=
ALLOW_DEMO_SEED=
